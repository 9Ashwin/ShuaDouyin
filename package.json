{
	"name": "shuadouyin",
	"version": "0.5.2",
	"packageManager": "pnpm@10.34.7",
	"description": "Browse Douyin with a persistent bot persona and a memory of its own",
	"type": "module",
	"license": "MIT",
	"bin": {
		"dy": "dist/cli.js"
	},
	"files": [
		"dist",
		"docs",
		"migrations",
		"scripts/install.sh",
		"README.md",
		"CHANGELOG.md",
		"README.en.md",
		"SECURITY.md",
		"LICENSE",
		"skills",
		".dy-build-commit",
		"!dist/**/*.map",
		"!docs/assets",
		"!dist/**/*.d.ts",
		".dy-build-origin"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "node scripts/build.ts",
		"check": "biome check . && tsc --noEmit",
		"format": "biome check --write .",
		"test": "node scripts/test.ts",
		"test:browser": "node scripts/test-browser.ts",
		"crap": "node scripts/crap.ts",
		"start": "node dist/cli.js",
		"hooks:install": "husky || true",
		"prepublishOnly": "node scripts/prepare.ts && node scripts/check-packed.ts",
		"prepare": "node scripts/prepare.ts"
	},
	"dependencies": {
		"@earendil-works/pi-tui": "1.4.0",
		"better-sqlite3": "13.0.3",
		"commander": "15.0.0",
		"drizzle-orm": "0.45.4",
		"marked": "18.0.11",
		"playwright-core": "1.64.1",
		"proper-lockfile": "4.1.2",
		"yaml": "2.8.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"esbuild": "0.25.12",
		"husky": "9.1.7",
		"typescript": "5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/9Ashwin/ShuaDouyin.git"
	},
	"homepage": "https://github.com/9Ashwin/ShuaDouyin#readme",
	"bugs": {
		"url": "https://github.com/9Ashwin/ShuaDouyin/issues"
	},
	"keywords": [
		"douyin",
		"agent",
		"cli",
		"automation"
	],
	"publishConfig": {
		"access": "public"
	}
}
